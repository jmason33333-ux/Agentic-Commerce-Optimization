// OpenAI Commerce Feed Specification-compliant schema
// Based on: https://developers.openai.com/commerce/specs/feed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App tables
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole    @default(MERCHANT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]
  suggestions   Suggestion[] @relation("ReviewedSuggestions")
  changeLogs    ChangeLog[]

  @@index([email])
}

enum UserRole {
  ADMIN
  AGENCY
  MERCHANT
}

model Workspace {
  id                   String    @id @default(cuid())
  name                 String
  platform             Platform  @default(SHOPIFY)
  shopDomain           String?
  shopAccessToken      String?

  // Policy settings
  autoApplyLowRisk     Boolean   @default(false)
  allowTitleOverwrite  Boolean   @default(false)
  allowDescOverwrite   Boolean   @default(false)

  // OpenAI Spec: Merchant Info (REQUIRED)
  sellerName           String?
  sellerUrl            String?
  sellerPrivacyPolicy  String?   // Required if checkout enabled
  sellerTos            String?   // Required if checkout enabled

  // OpenAI Spec: Returns (REQUIRED)
  returnPolicy         String?
  returnWindow         Int?      // days

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products      Product[]
  suggestions   Suggestion[]
  orderEvents   OrderEvent[]
  changeLogs    ChangeLog[]
  jobs          Job[]

  @@index([ownerId])
  @@index([shopDomain])
}

enum Platform {
  SHOPIFY
  ETSY
  CSV
}

model Product {
  id                     String   @id @default(cuid())
  workspaceId            String
  sourceId               String   // Shopify product ID

  // ===== OpenAI Flags (REQUIRED) =====
  enableSearch           Boolean  @default(true)
  enableCheckout         Boolean  @default(false)

  // ===== Basic Product Data (REQUIRED) =====
  title                  String   // Max 150 chars
  description            String?  @db.Text // Max 5000 chars
  link                   String?  // Product page URL (REQUIRED)
  gtin                   String?  // GTIN/UPC/ISBN 8-14 digits (required if mpn missing)
  mpn                    String?  // Manufacturer part number (required if gtin missing)

  // ===== Item Information =====
  condition              String   @default("new") // new|refurbished|used (required if not new)
  productCategory        String?  // REQUIRED - category path with ">" separator
  brand                  String?  // REQUIRED (max 70 chars) except movies/books/music
  material               String?  // REQUIRED (max 100 chars)
  dimensions             String?  // LxWxH with units
  length                 Decimal? @db.Decimal(10, 2)
  lengthUnit             String?
  width                  Decimal? @db.Decimal(10, 2)
  widthUnit              String?
  height                 Decimal? @db.Decimal(10, 2)
  heightUnit             String?
  weight                 Decimal? @db.Decimal(10, 2) // REQUIRED
  weightUnit             String?  // REQUIRED with weight
  ageGroup               String?  // newborn|infant|toddler|kids|adult

  // ===== Media (REQUIRED: at least image_link) =====
  imageLink              String?  // Primary image (REQUIRED)
  additionalImageLinks   Json?    // Array of additional images
  videoLink              String?
  model3dLink            String?  // GLB/GLTF preferred

  // ===== Price & Promotions (REQUIRED: price) =====
  price                  Decimal? @db.Decimal(10, 2) // REQUIRED
  currency               String   @default("USD")
  salePrice              Decimal? @db.Decimal(10, 2)
  salePriceStart         DateTime?
  salePriceEnd           DateTime?
  unitPricingMeasure     String?
  unitPricingBaseMeasure String?
  pricingTrend           String?  // e.g., "Lowest price in 6 months"

  // ===== Availability & Inventory (REQUIRED) =====
  availability           String   @default("in_stock") // in_stock|out_of_stock|preorder (REQUIRED)
  availabilityDate       DateTime? // Required if availability=preorder
  inventoryQuantity      Int      @default(0) // REQUIRED
  expirationDate         DateTime?
  pickupMethod           String?  // in_store|reserve|not_supported
  pickupSla              String?

  // ===== Variants (REQUIRED if variants exist) =====
  itemGroupId            String?  // Same for all variants (REQUIRED if has variants)
  itemGroupTitle         String?
  color                  String?  // Recommended for apparel (max 40 chars)
  size                   String?  // Recommended for apparel (max 20 chars)
  sizeSystem             String?  // ISO 3166 country code
  gender                 String?  // male|female|unisex
  offerId                String?
  customVariant1Category String?
  customVariant1Option   String?
  customVariant2Category String?
  customVariant2Option   String?
  customVariant3Category String?
  customVariant3Option   String?

  // ===== Fulfillment =====
  shipping               Json?    // Array of shipping options
  deliveryEstimate       DateTime?

  // ===== Performance Signals (RECOMMENDED) =====
  popularityScore        Decimal? @db.Decimal(3, 2) // 0-5 scale
  returnRate             Decimal? @db.Decimal(5, 2) // 0-100%

  // ===== Compliance =====
  warning                String?
  warningUrl             String?
  ageRestriction         Int?

  // ===== Reviews & Q&A (RECOMMENDED) =====
  productReviewCount     Int?
  productReviewRating    Decimal? @db.Decimal(3, 2) // 0-5 scale
  storeReviewCount       Int?
  storeReviewRating      Decimal? @db.Decimal(3, 2)
  qAndA                  String?  @db.Text
  rawReviewData          Json?

  // ===== Related Products (RECOMMENDED) =====
  relatedProductIds      Json?    // Array of product IDs
  relationshipType       String?  // part_of_set|often_bought_with|substitute|etc.

  // ===== Geo Tagging =====
  geoPrice               Json?    // Region-specific pricing
  geoAvailability        Json?    // Region-specific availability

  // ===== Legacy/Compatibility Fields =====
  vendor                 String?  // Legacy - use brand instead
  productType            String?  // Legacy - use productCategory instead
  tags                   Json?    // Legacy - supplementary tags
  images                 Json?    // Legacy - use imageLink + additionalImageLinks
  isPrimarySeller        Boolean  @default(false) // Legacy

  // ===== Internal Fields =====
  contentHash            String?  // SHA256 for change detection
  rawSource              Json?    // Full Shopify product object
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditResults   AuditResult[]
  suggestions    Suggestion[]
  changeLogs     ChangeLog[]

  @@unique([workspaceId, sourceId])
  @@index([workspaceId])
  @@index([contentHash])
  @@index([enableSearch])
  @@index([enableCheckout])
  @@index([availability])
  @@index([itemGroupId])
}

model AuditResult {
  id         String   @id @default(cuid())
  productId  String
  seoScore   Int      @default(0) // 0-100
  issues     Json?    // array of {issue_type, severity, message, spec_ref}
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Suggestion {
  id          String         @id @default(cuid())
  workspaceId String
  productId   String
  issueType   String         // e.g., "missing_gtin", "checkout_disabled", etc.
  aiPayload   Json           // proposed change
  riskLevel   RiskLevel
  status      SuggestionStatus @default(PENDING)
  reviewerId  String?
  errorMsg    String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  appliedAt   DateTime?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer    User?       @relation("ReviewedSuggestions", fields: [reviewerId], references: [id])
  changeLogs  ChangeLog[]

  @@index([workspaceId, status])
  @@index([productId])
  @@index([status])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model OrderEvent {
  id            String   @id @default(cuid())
  workspaceId   String
  orderId       String   // Shopify order ID
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  sourceChannel SourceChannel @default(WEB)
  rawPayload    Json?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, orderId])
  @@index([workspaceId, sourceChannel])
  @@index([createdAt])
}

enum SourceChannel {
  CHATGPT_AGENTIC
  WEB
  POS
  OTHER
}

model ChangeLog {
  id           String      @id @default(cuid())
  workspaceId  String
  productId    String
  suggestionId String?
  changeType   String      // "update_description", "enable_instant_checkout", etc.
  oldValue     Json?
  newValue     Json?
  actorType    ActorType   @default(USER)
  actorId      String?
  createdAt    DateTime    @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  suggestion Suggestion? @relation(fields: [suggestionId], references: [id])
  actor      User?       @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([productId])
  @@index([createdAt])
}

enum ActorType {
  USER
  SYSTEM
}

model Job {
  id          String    @id @default(cuid())
  workspaceId String
  type        JobType
  status      JobStatus @default(PENDING)
  progress    Int       @default(0) // 0-100
  totalItems  Int       @default(0)
  processedItems Int    @default(0)
  result      Json?     // success/error data
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([status])
}

enum JobType {
  PRODUCT_SYNC
  AUDIT_RUN
  APPLY_SUGGESTIONS
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
