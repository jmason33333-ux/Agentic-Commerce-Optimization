// Updated Prisma schema with full OpenAI Commerce Feed compliance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// [Keep existing NextAuth tables: Account, Session, VerificationToken, User unchanged]

model Workspace {
  id                   String    @id @default(cuid())
  name                 String
  platform             Platform  @default(SHOPIFY)
  shopDomain           String?
  shopAccessToken      String?
  ownerId              String

  // Policy settings
  autoApplyLowRisk     Boolean   @default(false)
  allowTitleOverwrite  Boolean   @default(false)
  allowDescOverwrite   Boolean   @default(false)

  // Merchant info (OpenAI spec required)
  sellerName           String?
  sellerUrl            String?
  sellerPrivacyPolicy  String?
  sellerTos            String?
  returnPolicy         String?
  returnWindow         Int?      // days

  // Shopify Integration Settings (CD #5.1, #5.2)
  syncSettings         Json?     // { autoSyncEnabled, syncInterval, syncInventory, syncPrices, syncNewProducts }

  // Smart Checkout Rules (CD #6.1)
  checkoutRules        Json?     // { enableCheckoutWhen: { inventoryMin, ratingMin, excludeTags, complianceMin, requireFields } }

  // Feature Flags (CD #15.2)
  featureFlags         Json?     // { ENABLE_ANALYTICS, ENABLE_BULK_OPERATIONS, ENABLE_SHOPIFY_SYNC, ENABLE_SMART_CHECKOUT }

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products      Product[]
  suggestions   Suggestion[]
  orderEvents   OrderEvent[]
  changeLogs    ChangeLog[]
  jobs          Job[]

  @@index([ownerId])
  @@index([shopDomain])
}

model Product {
  id                     String   @id @default(cuid())
  workspaceId            String
  sourceId               String   // Shopify product ID

  // OpenAI Flags (REQUIRED)
  enableSearch           Boolean  @default(true)
  enableCheckout         Boolean  @default(false)

  // Basic Product Data (REQUIRED)
  title                  String
  description            String?  @db.Text
  link                   String?  // Product page URL
  gtin                   String?  // GTIN/UPC/ISBN (required if mpn missing)
  mpn                    String?  // Manufacturer part number (required if gtin missing)

  // Item Information
  condition              String   @default("new") // new, refurbished, used
  productCategory        String?  // Category path with ">" separator
  brand                  String?  // REQUIRED (except movies/books)
  material               String?
  dimensions             String?  // LxWxH with units
  length                 Decimal? @db.Decimal(10, 2)
  lengthUnit             String?
  width                  Decimal? @db.Decimal(10, 2)
  widthUnit              String?
  height                 Decimal? @db.Decimal(10, 2)
  heightUnit             String?
  weight                 Decimal? @db.Decimal(10, 2) // REQUIRED
  weightUnit             String?  // REQUIRED with weight
  ageGroup               String?  // newborn, infant, toddler, kids, adult

  // Media (REQUIRED: at least image_link)
  imageLink              String?  // Primary image
  additionalImageLinks   Json?    // Array of additional images
  videoLink              String?
  model3dLink            String?

  // Price & Promotions (REQUIRED: price)
  price                  Decimal? @db.Decimal(10, 2)
  currency               String   @default("USD")
  salePrice              Decimal? @db.Decimal(10, 2)
  salePriceStart         DateTime?
  salePriceEnd           DateTime?
  unitPricingMeasure     String?
  unitPricingBaseMeasure String?
  pricingTrend           String?

  // Availability & Inventory (REQUIRED: availability)
  availability           String   @default("in_stock") // in_stock, out_of_stock, preorder
  availabilityDate       DateTime?
  inventoryQuantity      Int      @default(0)
  expirationDate         DateTime?
  pickupMethod           String?  // in_store, reserve, not_supported
  pickupSla              String?

  // Variants
  itemGroupId            String?  // REQUIRED if variants exist
  itemGroupTitle         String?
  color                  String?
  size                   String?
  sizeSystem             String?  // ISO 3166 country code
  gender                 String?  // male, female, unisex
  offerId                String?
  customVariant1Category String?
  customVariant1Option   String?
  customVariant2Category String?
  customVariant2Option   String?
  customVariant3Category String?
  customVariant3Option   String?

  // Fulfillment
  shipping               Json?    // Array of shipping options
  deliveryEstimate       DateTime?

  // Performance Signals
  popularityScore        Decimal? @db.Decimal(3, 2)
  returnRate             Decimal? @db.Decimal(5, 2)

  // Compliance
  warning                String?
  warningUrl             String?
  ageRestriction         Int?

  // Reviews & Q&A
  productReviewCount     Int?
  productReviewRating    Decimal? @db.Decimal(3, 2)
  storeReviewCount       Int?
  storeReviewRating      Decimal? @db.Decimal(3, 2)
  qAndA                  String?  @db.Text
  rawReviewData          Json?

  // Related Products
  relatedProductIds      Json?    // Array of product IDs
  relationshipType       String?  // part_of_set, often_bought_with, substitute, etc.

  // Geo Tagging
  geoPrice               Json?    // Region-specific pricing
  geoAvailability        Json?    // Region-specific availability

  // Legacy/compatibility
  vendor                 String?
  productType            String?
  tags                   Json?
  images                 Json?    // Deprecated - use imageLink + additionalImageLinks

  // Agent-Specific Optimization Fields (CD #1.1 - 20 points)
  useCases               String?  @db.Text // Use cases & benefits (7pts)
  targetAudience         String?  @db.Text // Target audience & context (7pts)
  comparableProducts     String?  @db.Text // Similar products, compatibility, differentiators (6pts)

  // Optimization Score (CD #1.1, #1.2)
  optimizationScore      Int?     // 0-100 raw points
  optimizationLevel      Int?     // 1-10 derived from score ranges
  scoreBreakdown         Json?    // Detailed category breakdown: { coreContent, productIdentity, agentFields, etc. }
  status                 String?  // "ready" (≥8, no pending), "pending" (has suggestions), "missing" (<5 or critical fields)
  lastScoreCalculation   DateTime? // When score was last calculated

  // Internal
  contentHash            String?
  rawSource              Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditResults   AuditResult[]
  suggestions    Suggestion[]
  changeLogs     ChangeLog[]

  @@unique([workspaceId, sourceId])
  @@index([workspaceId])
  @@index([contentHash])
  @@index([enableSearch])
  @@index([enableCheckout])
  @@index([availability])
  @@index([optimizationLevel])
  @@index([status])
  @@index([workspaceId, optimizationLevel])
  @@index([workspaceId, status])
}

// Enums
enum UserRole {
  ADMIN
  AGENCY
  MERCHANT
}

enum Platform {
  SHOPIFY
  ETSY
  CSV
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum SourceChannel {
  CHATGPT_AGENTIC
  WEB
  POS
  OTHER
}

enum ActorType {
  USER
  SYSTEM
}

enum JobType {
  PRODUCT_SYNC
  AUDIT_RUN
  APPLY_SUGGESTIONS
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App tables
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole    @default(MERCHANT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]
  suggestions   Suggestion[] @relation("ReviewedSuggestions")
  changeLogs    ChangeLog[]

  @@index([email])
}

model AuditResult {
  id         String   @id @default(cuid())
  productId  String
  seoScore   Int      @default(0)
  issues     Json?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Suggestion {
  id          String           @id @default(cuid())
  workspaceId String
  productId   String
  issueType   String
  aiPayload   Json
  riskLevel   RiskLevel
  status      SuggestionStatus @default(PENDING)
  reviewerId  String?
  errorMsg    String?          @db.Text

  // Score Impact (CD #3.1)
  scoreImpact Json?            // { category, points, currentLevel, newLevel, description }

  // Confidence Score (CD #7 from Next 5)
  confidence  Int?             // 0-100 confidence score from LLM

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  appliedAt   DateTime?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer    User?       @relation("ReviewedSuggestions", fields: [reviewerId], references: [id])
  changeLogs  ChangeLog[]

  @@index([workspaceId, status])
  @@index([productId])
  @@index([status])
  @@index([riskLevel])
  @@index([confidence])
}

model OrderEvent {
  id            String        @id @default(cuid())
  workspaceId   String
  orderId       String
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  sourceChannel SourceChannel @default(WEB)
  rawPayload    Json?
  createdAt     DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, orderId])
  @@index([workspaceId, sourceChannel])
  @@index([createdAt])
}

model ChangeLog {
  id           String    @id @default(cuid())
  workspaceId  String
  productId    String
  suggestionId String?
  changeType   String
  oldValue     Json?
  newValue     Json?
  actorType    ActorType @default(USER)
  actorId      String?
  createdAt    DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  suggestion Suggestion? @relation(fields: [suggestionId], references: [id])
  actor      User?       @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([productId])
  @@index([createdAt])
}

model Job {
  id              String    @id @default(cuid())
  workspaceId     String
  type            JobType
  status          JobStatus @default(PENDING)
  progress        Int       @default(0)
  totalItems      Int       @default(0)
  processedItems  Int       @default(0)
  result          Json?
  error           String?   @db.Text
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([status])
}
